{% block turnstile_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' cf-turnstile')|trim}) %}

    {% if turnstile_load_script %}
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    {% endif %}

    <div
        id="{{ id }}"
        data-sitekey="{{ site_key }}"
        data-theme="{{ turnstile_theme }}"
        data-response-field-name="{{ full_name }}"
        {{ block('attributes') }}
    ></div>
{% endblock %}
